# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Required: secret for the webhook URL, at least 24 characters.
# Webhook URL in Yandex Dialogs: https://YOUR-PROJECT.vercel.app/api?key=THIS_SECRET
WEBHOOK_SECRET=
